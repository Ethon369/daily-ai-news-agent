# Copy to .env. Never commit credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
DATA_DIR=./data
# Windows example; Linux uses /bin/bash automatically
# BASH_PATH=D:/Git/bin/bash.exe
AGENT_MAX_ROUNDS=12
AGENT_MAX_TOOLS=24
AGENT_TIMEOUT=180
SCHEDULER_ENABLED=true
